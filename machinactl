#!/usr/bin/env bash
# machinactl — Install, manage, and demo machina (Linux hypervisor host control plane)
#
# Usage: machinactl <command> [options]
#
# Commands:
#   deps            Install all system dependencies
#   build           Build the backend (and optionally web UI)
#   test            Run the test suite
#   install         Install machina to the system
#   uninstall       Remove machina from the system
#   deploy          Full deployment: deps → build → install → start → verify
#   reinstall       Rebuild and reinstall: stop → build → install → start → verify
#   upgrade         Git pull + reinstall
#   start           Start the machina-daemon service
#   stop            Stop the service
#   restart         Restart the service
#   status          Show service status
#   logs            Follow service logs
#   backup now      Run VM backup immediately
#   backup enable   Enable daily backup timer
#   backup disable  Disable backup timer
#   backup status   Show backup timer and storage info
#   backup logs     Follow backup logs
#   verify          Post-install smoke test (API, VMs, backup)
#   health          Deep health check (service, API, disk, libvirt, timers)
#   doctor          Check system readiness
#   tls             Generate self-signed TLS certificate
#   demo            Run interactive API demo
#   audit verify    Verify signed audit log (API or local file)
#   integrations    Show KubeVirt/k8s/automation integration status
#   sprite          Manage disposable sandbox VMs (list/get/create/delete/golden-images)
#   netpol          VM network policies (CiliumNetworkPolicy schema)
#   flow            Packet flows (observe / top / stats)
#   vm label        Show or edit VM labels
#   vm quarantine   Cut a VM off the network for a fixed time (vm release lifts it)
#   help            Show this help
#
# Web UI sign-in uses PAM (Linux accounts on this host), not a separate machina password.

set -euo pipefail

# ── Globals ─────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
API_URL="${MACHINA_URL:-https://127.0.0.1:5092}"
API_VERSION="v1"

# ── Helpers ─────────────────────────────────────────────────────────────
info()  { echo "ℹ️  $*"; }
ok()    { echo "✅ $*"; }
warn()  { echo "⚠️  $*"; }
err()   { echo "❌ $*" >&2; }
step()  { echo ""; echo "➡️  $*"; }
need_root() {
    if [[ $EUID -ne 0 ]]; then
        info "Escalating to root..."
        exec sudo "$0" "${ORIGINAL_ARGS[@]}"
    fi
}

detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$ID"
    else
        echo "unknown"
    fi
}

# pam-sys (bindgen) needs libclang at compile time
export_libclang_path() {
    if [[ -n "${LIBCLANG_PATH:-}" && -d "$LIBCLANG_PATH" ]]; then
        export LIBCLANG_PATH
        return 0
    fi

    local llvm_cfg libdir candidate
    llvm_cfg="$(command -v llvm-config 2>/dev/null || true)"
    if [[ -n "$llvm_cfg" ]]; then
        libdir="$("$llvm_cfg" --libdir 2>/dev/null || true)"
        if [[ -n "$libdir" && -d "$libdir" ]]; then
            if [[ -e "$libdir/libclang.so" || -e "$libdir/libclang.so.1" ]]; then
                export LIBCLANG_PATH="$libdir"
                return 0
            fi
        fi
    fi

    for candidate in /usr/lib/llvm/*/lib /usr/lib64/llvm/*/lib; do
        [[ -d "$candidate" ]] || continue
        if [[ -e "$candidate/libclang.so" || -e "$candidate/libclang.so.1" ]]; then
            export LIBCLANG_PATH="$candidate"
            return 0
        fi
    done

    for candidate in /usr/lib /usr/lib64; do
        if [[ -e "$candidate/libclang.so" || -e "$candidate/libclang.so.1" ]]; then
            export LIBCLANG_PATH="$candidate"
            return 0
        fi
    done

    return 0
}

# ── deps: Install system dependencies ───────────────────────────────────
cmd_deps() {
    need_root
    step "Installing system dependencies"

    local distro
    distro=$(detect_distro)
    info "Detected: $distro"

    case "$distro" in
        fedora|rhel|centos|rocky|alma)
            info "Installing packages via dnf..."

            info "Libvirt & virtualization..."
            dnf install -y \
                libvirt libvirt-devel libvirt-daemon-kvm \
                qemu-kvm qemu-img virt-install virt-viewer \
                || { err "Failed to install libvirt packages"; exit 1; }

            info "Build tools..."
            dnf install -y \
                gcc gcc-c++ make git pkg-config \
                openssl-devel systemd-devel \
                pam-devel clang-libs clang-devel \
                || { err "Failed to install build deps"; exit 1; }

            info "Utilities..."
            dnf install -y \
                curl jq rsync socat nftables wireguard-tools \
                || { err "Failed to install utilities"; exit 1; }

            ok "All Fedora/RHEL packages installed"
            ;;

        debian|ubuntu|linuxmint|pop)
            info "Installing packages via apt..."

            apt-get update -qq || { err "apt-get update failed"; exit 1; }

            info "Libvirt & virtualization..."
            apt-get install -y \
                libvirt-daemon-system libvirt-dev libvirt-clients \
                qemu-kvm qemu-utils virtinst virt-viewer \
                || { err "Failed to install libvirt packages"; exit 1; }

            info "Build tools..."
            apt-get install -y \
                gcc g++ make git pkg-config \
                libssl-dev libsystemd-dev \
                libpam0g-dev libclang-dev clang llvm-dev \
                || { err "Failed to install build deps"; exit 1; }

            info "Utilities..."
            apt-get install -y \
                curl jq rsync socat nftables wireguard-tools \
                || { err "Failed to install utilities"; exit 1; }

            ok "All Ubuntu/Debian packages installed"
            ;;

        *)
            err "Unsupported distribution: $distro"
            echo "Install manually: libvirt, qemu-kvm, gcc, make, git, pkg-config, openssl-dev, curl, jq, nftables, wireguard-tools"
            exit 1
            ;;
    esac

    # Rust toolchain
    step "Rust toolchain"
    if ! command -v cargo &>/dev/null; then
        info "Installing Rust via rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
        # shellcheck source=/dev/null
        source "$HOME/.cargo/env" 2>/dev/null || true
        ok "Rust installed ($(rustc --version 2>/dev/null || echo 'reload shell'))"
    else
        ok "Rust already installed ($(rustc --version))"
    fi

    # Node.js for web UI
    step "Node.js (for web UI)"
    if ! command -v node &>/dev/null; then
        info "Installing Node.js..."
        case "$distro" in
            fedora|rhel|centos|rocky|alma) dnf install -y nodejs npm || warn "Node.js install failed" ;;
            debian|ubuntu|linuxmint|pop)   apt-get install -y nodejs npm || warn "Node.js install failed" ;;
        esac
        if command -v node &>/dev/null; then
            ok "Node.js installed ($(node --version))"
        else
            warn "Node.js not available — web UI build will be skipped"
        fi
    else
        ok "Node.js already installed ($(node --version))"
    fi

    # Enable libvirtd
    step "Enabling services"
    systemctl enable --now libvirtd.service 2>/dev/null && ok "libvirtd enabled" || warn "libvirtd not available"

    # Ensure user is in libvirt group
    if [[ -n "${SUDO_USER:-}" ]]; then
        usermod -aG libvirt "$SUDO_USER" 2>/dev/null && ok "Added $SUDO_USER to libvirt group" || true
    fi

    # KVM check
    step "KVM"
    if [[ -e /dev/kvm ]]; then
        ok "KVM available"
    else
        warn "KVM not available (VMs will be slow)"
    fi

    ok "All dependencies installed"
    echo ""
    info "Next: run ./machinactl build"
}

# ── build ───────────────────────────────────────────────────────────────
cmd_build() {
    step "Building machina"

    local build_web=1
    [[ "${1:-}" == "--no-web" ]] && build_web=0

    info "Building backend (Rust)..."
    cd "$SCRIPT_DIR"
    export_libclang_path
    cargo build --workspace --release 2>&1
    ok "Backend built: machina-daemon"

    if [[ $build_web -eq 1 ]] && [[ -d "$SCRIPT_DIR/web" ]]; then
        if command -v node &>/dev/null; then
            info "Building web UI..."
            cd "$SCRIPT_DIR/web"
            npm install --silent 2>&1 | tail -1
            npm run build 2>&1 | tail -1
            ok "Web UI built"
        else
            warn "Node.js not found — skipping web UI"
        fi
    fi

    echo ""
    ok "Build complete"
    info "Next: run ./machinactl install"
}

# ── test ────────────────────────────────────────────────────────────────
cmd_test() {
    step "Running test suite"
    cd "$SCRIPT_DIR"
    export_libclang_path
    cargo test --workspace 2>&1
    ok "All tests passed"
}

# ── install ─────────────────────────────────────────────────────────────
cmd_install() {
    need_root
    step "Installing machina"

    if [[ ! -f "$SCRIPT_DIR/target/release/machina-daemon" ]]; then
        err "Not built yet. Run: ./machinactl build"
        exit 1
    fi

    cd "$SCRIPT_DIR"
    make install
    systemctl daemon-reload

    # Create state directories
    mkdir -p /var/lib/machina/backups

    ok "machina installed"
    info "Start with: ./machinactl start"
}

# ── uninstall ───────────────────────────────────────────────────────────
cmd_uninstall() {
    need_root
    step "Uninstalling machina"

    if [[ -t 0 ]]; then
        warn "This will stop machina-daemon and remove installed binaries, configs, and systemd units."
        read -rp "Continue? [y/N] " answer
        if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
            info "Aborted"
            return 1
        fi
    fi

    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        info "Stopping machina-daemon..."
        systemctl stop machina-daemon
    fi
    systemctl disable machina-daemon machina-backup.timer 2>/dev/null || true

    cd "$SCRIPT_DIR"
    make uninstall 2>/dev/null || true
    systemctl daemon-reload

    ok "machina uninstalled"
    warn "State data preserved at /var/lib/machina"
    warn "To remove all data: sudo rm -rf /var/lib/machina"
}

# ── deploy ──────────────────────────────────────────────────────────────
cmd_deploy() {
    need_root
    step "Full Deployment"
    echo ""
    echo "📋 This will:"
    echo "  1. Install all system dependencies"
    echo "  2. Build the backend (release mode)"
    echo "  3. Install binaries, configs, and systemd units"
    echo "  4. Start the machina-daemon service"
    echo "  5. Run post-install verification"
    echo ""

    cmd_deps "$@"
    echo ""

    if [[ -n "${SUDO_USER:-}" ]]; then
        info "Building as $SUDO_USER..."
        su - "$SUDO_USER" -c "cd '$SCRIPT_DIR' && ./machinactl build --no-web"
    else
        cmd_build --no-web
    fi
    echo ""

    cmd_install
    echo ""

    cmd_start
    echo ""

    local verify_status=0
    cmd_verify || verify_status=$?

    if [[ $verify_status -eq 0 ]]; then
        step "Deployment Complete"
    else
        step "Deployment Complete (with verification failures — see above)"
    fi
    echo ""
    echo "  🔗 API:     $API_URL"
    echo "  📊 Status:  ./machinactl status"
    echo "  📜 Logs:    sudo journalctl -u machina-daemon -f"
    echo ""

    return $verify_status
}

# ── reinstall ───────────────────────────────────────────────────────────
cmd_reinstall() {
    need_root
    step "Reinstalling machina"

    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        info "Stopping machina-daemon..."
        systemctl stop machina-daemon
    fi

    if [[ -n "${SUDO_USER:-}" ]]; then
        info "Rebuilding as $SUDO_USER..."
        su - "$SUDO_USER" -c "cd '$SCRIPT_DIR' && ./machinactl build --no-web"
    else
        cmd_build --no-web
    fi
    echo ""

    cd "$SCRIPT_DIR"
    make install
    systemctl daemon-reload
    systemctl start machina-daemon
    sleep 2

    if systemctl is-active --quiet machina-daemon; then
        ok "machina reinstalled and running"
        echo ""
        cmd_verify || true
    else
        err "Failed to start. Check: sudo journalctl -u machina-daemon -e"
        exit 1
    fi
}

# ── upgrade ─────────────────────────────────────────────────────────────
cmd_upgrade() {
    need_root
    step "Upgrading machina"

    if [[ -n "${SUDO_USER:-}" ]]; then
        info "Pulling latest code as $SUDO_USER..."
        su - "$SUDO_USER" -c "cd '$SCRIPT_DIR' && git pull --ff-only"
    else
        cd "$SCRIPT_DIR"
        git pull --ff-only
    fi
    echo ""

    cmd_reinstall
}

# ── verify: Post-install smoke test ─────────────────────────────────────
cmd_verify() {
    step "Post-Install Verification"
    local failures=0

    info "Checking service..."
    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        ok "Service is running"
    elif pgrep -f "machina-daemon" &>/dev/null; then
        ok "machina-daemon process is running"
    else
        err "machina-daemon is not running"
        ((failures++)) || true
        return 1
    fi

    info "Checking API..."
    local http_code
    http_code=$(curl -sk -o /dev/null -w "%{http_code}" "$API_URL/api/$API_VERSION/health" --max-time 5 2>/dev/null) || http_code="000"
    if [[ "$http_code" == "200" ]]; then
        ok "API responding (HTTP $http_code)"
    else
        err "API not responding (HTTP $http_code)"
        ((failures++)) || true
    fi

    info "Checking integrations status..."
    local int_code
    int_code=$(curl -sk -o /dev/null -w "%{http_code}" "$API_URL/api/$API_VERSION/integrations/status" --max-time 5 2>/dev/null) || int_code="000"
    if [[ "$int_code" == "200" ]]; then
        ok "Integrations status (HTTP $int_code)"
    else
        warn "Integrations status HTTP $int_code"
    fi

    info "Checking VM list..."
    local vm_response
    vm_response=$(curl -sk "$API_URL/api/$API_VERSION/vms" --max-time 5 2>/dev/null)
    if [[ -n "$vm_response" ]]; then
        local vm_count
        vm_count=$(echo "$vm_response" | jq 'if type=="array" then length else 0 end' 2>/dev/null || echo "0")
        ok "VM list: $vm_count VM(s)"
    else
        warn "VM list endpoint not responding"
    fi

    info "Checking libvirt..."
    if virsh list --all &>/dev/null; then
        local running
        running=$(virsh list --state-running --name 2>/dev/null | grep -c . || echo "0")
        local total
        total=$(virsh list --all --name 2>/dev/null | grep -c . || echo "0")
        ok "libvirt: $running running, $total total"
    else
        warn "virsh not accessible"
    fi

    info "Checking backup timer..."
    if systemctl is-active --quiet machina-backup.timer 2>/dev/null; then
        ok "Backup timer active"
    else
        warn "Backup timer not active (enable with: systemctl enable --now machina-backup.timer)"
    fi

    echo ""
    if [[ $failures -eq 0 ]]; then
        ok "All verification checks passed"
    else
        err "$failures check(s) failed"
        return 1
    fi
}

# ── health: Deep health check ──────────────────────────────────────────
cmd_health() {
    step "machina Health Check"
    local warnings=0 errors=0

    echo ""
    echo "📦 Service"
    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        ok "machina-daemon is running"
    else
        err "machina-daemon is not running"; ((errors++)) || true
    fi

    echo ""
    echo "🔗 API"
    local http_code
    http_code=$(curl -sk -o /dev/null -w "%{http_code}" "$API_URL/api/$API_VERSION/health" --max-time 5 2>/dev/null) || http_code="000"
    if [[ "$http_code" == "200" ]]; then
        ok "API responding (HTTP $http_code)"
    else
        err "API not responding (HTTP $http_code)"; ((errors++)) || true
    fi

    echo ""
    echo "🖥️  Libvirt"
    if virsh uri &>/dev/null; then
        ok "libvirt connected: $(virsh uri 2>/dev/null)"
        local running total
        running=$(virsh list --state-running --name 2>/dev/null | grep -c . || echo "0")
        total=$(virsh list --all --name 2>/dev/null | grep -c . || echo "0")
        ok "VMs: $running running, $total total"
    else
        err "libvirt not accessible"; ((errors++)) || true
    fi

    echo ""
    echo "💾 Disk space"
    local backup_dir="/var/lib/machina/backups"
    if [[ -d "$backup_dir" ]]; then
        local size usage
        size=$(du -sh "$backup_dir" 2>/dev/null | cut -f1)
        usage=$(df "$backup_dir" | tail -1 | awk '{print $5}' | tr -d '%')
        if [[ "$usage" -lt 80 ]]; then
            ok "Backups: $size (${usage}% disk used)"
        elif [[ "$usage" -lt 95 ]]; then
            warn "Backups: $size (${usage}% disk used — getting full)"; ((warnings++)) || true
        else
            err "Backups: $size (${usage}% disk used — CRITICAL)"; ((errors++)) || true
        fi
    fi

    echo ""
    echo "⏱️  Timers"
    if systemctl is-active --quiet machina-backup.timer 2>/dev/null; then
        ok "Backup timer active"
    else
        warn "Backup timer not active"; ((warnings++)) || true
    fi

    echo ""
    echo "⚙️  System"
    if [[ -e /dev/kvm ]]; then ok "KVM available"; else warn "KVM not available"; ((warnings++)) || true; fi
    local mem_avail mem_total mem_pct
    mem_avail=$(awk '/MemAvailable/ {printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null || echo "0")
    mem_total=$(awk '/MemTotal/ {printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null || echo "1")
    mem_pct=$((100 - (mem_avail * 100 / mem_total)))
    ok "Memory: ${mem_avail}MB available (${mem_pct}% used)"
    ok "Load: $(awk '{print $1}' /proc/loadavg) ($(nproc) CPUs)"

    echo ""
    if [[ $errors -gt 0 ]]; then
        echo "❌ CRITICAL — $errors error(s), $warnings warning(s)"; return 2
    elif [[ $warnings -gt 0 ]]; then
        echo "⚠️ DEGRADED — $warnings warning(s)"; return 1
    else
        echo "✅ HEALTHY — all checks passed"
    fi
}

# ── backup ──────────────────────────────────────────────────────────────
cmd_backup() {
    local subcmd="${1:-now}"
    case "$subcmd" in
        now)
            need_root
            step "Running VM backup now"
            if [[ -x "$SCRIPT_DIR/scripts/backup.sh" ]]; then
                "$SCRIPT_DIR/scripts/backup.sh"
            else
                err "Backup script not found at scripts/backup.sh"
                exit 1
            fi
            ;;
        enable)
            need_root
            systemctl enable --now machina-backup.timer
            ok "Backup timer enabled (daily at 2:00 AM)"
            systemctl list-timers machina-backup.timer --no-pager
            ;;
        disable)
            need_root
            systemctl disable --now machina-backup.timer
            ok "Backup timer disabled"
            ;;
        status)
            echo ""
            if systemctl is-active --quiet machina-backup.timer 2>/dev/null; then
                ok "Backup timer is active"
            else
                warn "Backup timer is inactive"
            fi
            echo ""
            systemctl list-timers machina-backup.timer --no-pager 2>/dev/null || true
            echo ""
            local backup_dir="/var/lib/machina/backups"
            info "Backup directory: $backup_dir"
            if [[ -d "$backup_dir" ]]; then
                info "Backup count: $(find "$backup_dir" -maxdepth 2 -name "*.xml" 2>/dev/null | wc -l) configs"
                info "Total size: $(du -sh "$backup_dir" 2>/dev/null | cut -f1)"
            fi
            ;;
        logs)
            journalctl -u machina-backup -f --no-hostname
            ;;
        *)
            echo "Usage: machinactl backup <now|enable|disable|status|logs>"
            ;;
    esac
}

# ── start/stop/restart/status/logs ──────────────────────────────────────
cmd_start() {
    need_root
    step "Starting machina-daemon"
    systemctl start machina-daemon
    sleep 2
    if systemctl is-active --quiet machina-daemon; then
        ok "machina-daemon is running"
        info "API: $API_URL"
    else
        err "Failed to start. Check: sudo journalctl -u machina-daemon -e"
        exit 1
    fi
}

cmd_stop() {
    need_root
    systemctl stop machina-daemon
    ok "machina-daemon stopped"
}

cmd_restart() {
    need_root
    systemctl restart machina-daemon
    sleep 2
    if systemctl is-active --quiet machina-daemon; then
        ok "machina-daemon restarted"
    else
        err "Failed to restart. Check: sudo journalctl -u machina-daemon -e"
    fi
}

cmd_status() {
    echo ""
    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        ok "machina-daemon is running"
    else
        warn "machina-daemon is stopped"
    fi
    echo ""
    systemctl status machina-daemon --no-pager 2>/dev/null || true
}

cmd_logs() {
    journalctl -u machina-daemon -f --no-hostname "${@}"
}

# ── doctor ──────────────────────────────────────────────────────────────
cmd_doctor() {
    step "System Readiness Check"
    local issues=0

    local distro
    distro=$(detect_distro)
    info "Distribution: $distro"

    # systemd version
    local sd_ver
    sd_ver=$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}') || sd_ver="unknown"
    ok "systemd $sd_ver"

    # KVM
    if [[ -e /dev/kvm ]]; then ok "KVM available"; else warn "KVM not available"; ((issues++)) || true; fi

    # Required commands
    for cmd in virsh virt-install qemu-img curl jq; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd found"
        else
            err "$cmd not found"; ((issues++)) || true
        fi
    done

    # Optional
    for cmd in rsync socat virt-viewer; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd found (optional)"
        else
            warn "$cmd not found (optional)"
        fi
    done

    # Rust
    if command -v cargo &>/dev/null; then
        ok "Rust $(rustc --version | awk '{print $2}')"
    else
        err "Rust toolchain not installed"; ((issues++)) || true
    fi

    # libvirtd
    if systemctl is-active --quiet libvirtd 2>/dev/null; then
        ok "libvirtd is running"
    else
        warn "libvirtd is not running"
    fi

    # machina
    if command -v machina-daemon &>/dev/null; then
        ok "machina-daemon is installed"
    else
        warn "machina-daemon not yet installed"
    fi

    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        ok "machina-daemon is running"
    else
        warn "machina-daemon is not running"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        ok "System is ready"
    else
        warn "$issues issue(s) found — run ./machinactl deps to fix"
    fi
}

# ── tls ─────────────────────────────────────────────────────────────────
cmd_tls() {
    need_root
    step "TLS Certificate Setup"

    local cert_dir="/etc/machina/ssl"
    local cert_file="$cert_dir/cert.pem"
    local key_file="$cert_dir/key.pem"

    mkdir -p "$cert_dir"

    if [[ -f "$cert_file" && -f "$key_file" ]]; then
        local expiry
        expiry=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2)
        ok "Certificate already exists (expires: $expiry)"
        read -rp "Regenerate? [y/N] " answer
        [[ "$answer" != "y" && "$answer" != "Y" ]] && return
    fi

    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)

    info "Generating self-signed certificate for $hostname..."
    # umask 077 so key_file is created non-world-readable from the first byte openssl
    # writes — no window where the private key sits world-readable before the chmod below.
    (umask 077 && openssl req -x509 -newkey rsa:4096 \
        -keyout "$key_file" -out "$cert_file" \
        -sha256 -days 365 -nodes \
        -subj "/CN=$hostname/O=machina" \
        -addext "subjectAltName=DNS:$hostname,DNS:localhost,IP:127.0.0.1" \
        2>/dev/null)

    chmod 600 "$key_file"
    chmod 644 "$cert_file"

    ok "Certificate generated"
    info "Cert: $cert_file"
    info "Key:  $key_file"
}

