# ── sprites (disposable sandbox VMs) ──────────────────────────────────────
cmd_sprite() {
    local subcmd="${1:-list}"
    shift || true

    local auth_header=()
    if [[ -n "${MACHINA_API_TOKEN:-}" ]]; then
        auth_header=(-H "Authorization: Bearer ${MACHINA_API_TOKEN}")
    fi

    case "$subcmd" in
        list)
            curl -sk "${auth_header[@]}" "$API_URL/api/$API_VERSION/sprites" | jq '.' 2>/dev/null || echo "(no response)"
            ;;
        get)
            local id="${1:?Usage: machinactl sprite get <id>}"
            curl -sk "${auth_header[@]}" "$API_URL/api/$API_VERSION/sprites/$id" | jq '.' 2>/dev/null || echo "(no response)"
            ;;
        golden-images)
            curl -sk "${auth_header[@]}" "$API_URL/api/$API_VERSION/sprites/golden-images" | jq '.' 2>/dev/null || echo "(no response)"
            ;;
        create)
            local golden_image="" vcpus=1 memory_mb=512 ttl_seconds=300 backend="libvirt" network_egress=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --golden-image)   golden_image="$2"; shift 2 ;;
                    --vcpus)          vcpus="$2"; shift 2 ;;
                    --memory-mb)      memory_mb="$2"; shift 2 ;;
                    --ttl-seconds)    ttl_seconds="$2"; shift 2 ;;
                    --backend)        backend="$2"; shift 2 ;;
                    --network-egress) network_egress=true; shift ;;
                    *) err "Unknown option: $1"; exit 1 ;;
                esac
            done
            if [[ -z "$golden_image" ]]; then
                err "Usage: machinactl sprite create --golden-image NAME [--vcpus N] [--memory-mb N] [--ttl-seconds N] [--backend libvirt|cloudhypervisor|firecracker] [--network-egress]"
                exit 1
            fi
            local body
            body=$(jq -n \
                --arg golden_image "$golden_image" \
                --argjson vcpus "$vcpus" \
                --argjson memory_mb "$memory_mb" \
                --argjson ttl_seconds "$ttl_seconds" \
                --arg backend "$backend" \
                --argjson network_egress "$network_egress" \
                '{golden_image: $golden_image, vcpus: $vcpus, memory_mb: $memory_mb, ttl_seconds: $ttl_seconds, backend: $backend, network_egress: $network_egress}')
            curl -sk -X POST "${auth_header[@]}" -H "Content-Type: application/json" -d "$body" \
                "$API_URL/api/$API_VERSION/sprites" | jq '.' 2>/dev/null || echo "(no response)"
            ;;
        delete)
            local id="${1:?Usage: machinactl sprite delete <id>}"
            curl -sk -X DELETE "${auth_header[@]}" "$API_URL/api/$API_VERSION/sprites/$id" | jq '.' 2>/dev/null || echo "(no response)"
            ;;
        *)
            echo "Usage: machinactl sprite <list|get|create|delete|golden-images>"
            echo ""
            echo "  machinactl sprite list"
            echo "  machinactl sprite get <id>"
            echo "  machinactl sprite golden-images"
            echo "  machinactl sprite create --golden-image NAME [--vcpus N] [--memory-mb N] \\"
            echo "                            [--ttl-seconds N] [--backend libvirt|cloudhypervisor|firecracker] [--network-egress]"
            echo "  machinactl sprite delete <id>"
            echo ""
            echo "Create/delete need write access — set MACHINA_API_TOKEN to a Bearer token"
            echo "(mint one via POST $API_URL/api/$API_VERSION/tokens as an admin, or sign in to the web UI)."
            ;;
    esac
}

# ── VM network policy / labels / flows ───────────────────────────────────
# Args: the remaining CLI args; consumes a leading or trailing --fleet.
np_setup() {
    # shellcheck source=scripts/lib/netpol-ctl.sh
    source "$SCRIPT_DIR/scripts/lib/netpol-ctl.sh"
    NP_BASE="$API_URL/api/$API_VERSION"
    if [[ "${NP_FLEET:-0}" == 1 ]]; then
        NP_BASE="$API_URL/api/$API_VERSION/platform/controller/api/$API_VERSION"
    fi
    NP_AUTH=()
    if [[ -n "${MACHINA_API_TOKEN:-}" ]]; then
        NP_AUTH=(-H "Authorization: Bearer ${MACHINA_API_TOKEN}")
    elif [[ -n "${MACHINA_USER:-}" && -n "${MACHINA_PASS:-}" ]]; then
        # Reuse one session across invocations: /auth/login is rate limited.
        NP_JAR="${MACHINA_COOKIE_JAR:-$HOME/.machina/cli-session}"
        mkdir -p "$(dirname "$NP_JAR")"
        local code
        code=$(curl -sk -b "$NP_JAR" -o /dev/null -w '%{http_code}' "$API_URL/api/$API_VERSION/auth/session" 2>/dev/null) || code=000
        if [[ "$code" != 200 ]]; then
            (umask 077 && : >"$NP_JAR")
            # Password over stdin so it never shows up in argv.
            code=$(MACHINA_USER="$MACHINA_USER" MACHINA_PASS="$MACHINA_PASS" jq -n '{username: env.MACHINA_USER, password: env.MACHINA_PASS}' |
                curl -sk -c "$NP_JAR" -o /dev/null -w '%{http_code}' -X POST "$API_URL/api/$API_VERSION/auth/login" \
                    -H 'Content-Type: application/json' --data-binary @-) || code=000
            if [[ "$code" != 200 ]]; then
                local hint=""
                [[ "$code" == 429 ]] && hint=", rate limited — wait a minute"
                err "login as $MACHINA_USER failed (HTTP $code$hint)"
                exit 1
            fi
        fi
        NP_AUTH=(-b "$NP_JAR")
    fi
}

np_run() {
    local fn=$1
    shift
    local args=() a
    NP_FLEET=0
    for a in "$@"; do
        if [[ "$a" == "--fleet" ]]; then NP_FLEET=1; else args+=("$a"); fi
    done
    np_setup
    "$fn" "${args[@]+"${args[@]}"}"
}

cmd_vm() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        label|labels) np_run np_label_main "$@" ;;
        quarantine|isolate) np_run np_quarantine_main "$@" ;;
        release|unquarantine) np_run np_release_main "$@" ;;
        sleep|wake) np_run np_sleep_main "$sub" "$@" --fleet ;;
        sleep-policy) np_run np_sleep_policy_main "$@" --fleet ;;
        sleeping) np_run np_sleeping_main "$@" --fleet ;;
        restore-points) np_run np_tt_main list "$@" --fleet ;;
        restore-point) np_run np_tt_main create "$@" --fleet ;;
        rewind) np_run np_tt_main rewind "$@" --fleet ;;
        fork) np_run np_tt_main fork "$@" --fleet ;;
        fork-detach) np_run np_tt_main detach "$@" --fleet ;;
        *)
            echo "Usage: machinactl vm label VM [key=value ...] [key- ...] [--fleet]"
            echo "       machinactl vm quarantine VM [--for 1h] [--allow-host-ssh] [--reason TEXT] [--fleet]"
            echo "       machinactl vm release VM [--fleet]"
            echo "       machinactl vm sleep|wake VM                 Scale to zero / restore (controller)"
            echo "       machinactl vm sleep-policy VM [MIN|inherit|never]   Auto-sleep after idle"
            echo "       machinactl vm sleep-policy --project P [MIN|never|clear]"
            echo "       machinactl vm sleeping                      Sleeping VMs and RAM handed back"
            echo "       machinactl vm restore-points VM [--every MIN|off] [--keep N]"
