# ── audit verify ───────────────────────────────────────────────────────
cmd_audit_verify() {
    step "Audit log signature verification"
    local max_lines="${1:-50000}"
    if curl -sfk "$API_URL/api/$API_VERSION/health" &>/dev/null; then
        info "Using API $API_URL/api/$API_VERSION/audit/verify"
        curl -sk "$API_URL/api/$API_VERSION/audit/verify?max_lines=$max_lines" | jq '.' 2>/dev/null || \
            curl -sk "$API_URL/api/$API_VERSION/audit/verify?max_lines=$max_lines"
        return
    fi
    local log="/var/lib/machina/audit.log"
    if [[ ! -f "$log" ]]; then
        err "No audit log at $log and daemon is not reachable"
        exit 1
    fi
    info "Verifying $log locally (sha256 lines)"
    local total=0 valid=0 invalid=0 unsigned=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" ]] && continue
        total=$((total + 1))
        if [[ "$line" != sha256:* ]]; then
            unsigned=$((unsigned + 1))
            continue
        fi
        local hex="${line#sha256:}"
        hex="${hex%%$'\t'*}"
        local payload="${line#sha256:*$'\t'}"
        local expect
        expect=$(printf '%s' "$payload" | sha256sum | awk '{print $1}')
        if [[ "${hex,,}" == "${expect,,}" ]]; then
            valid=$((valid + 1))
        else
            invalid=$((invalid + 1))
        fi
    done < "$log"
    ok "total=$total signed_valid=$valid signed_invalid=$invalid unsigned=$unsigned"
}

