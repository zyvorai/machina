[Unit]
Description=Machina host agent (libvirt executor)
Documentation=https://github.com/zyvorailabs/machina
After=network-online.target machina-controller.service
Wants=network-online.target libvirtd.service
StartLimitIntervalSec=300
StartLimitBurst=10
# Do not Requires=libvirtd: on RHEL/CentOS 9 the monolithic unit may start
# minutes after boot (socket-activated daemons); a hard Requires leaves agent dead.

[Service]
Type=simple
User=root
Group=root

EnvironmentFile=-/etc/default/machina-platform
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=MACHINA_LIBVIRT_URI=qemu:///system

ExecStartPre=-/usr/bin/systemctl start libvirtd.service
ExecStart=/usr/local/bin/machina-agent --listen 127.0.0.1:50051 --console-listen 127.0.0.1:50052
Restart=always
RestartSec=5
TimeoutStopSec=30

# Agent only execs virsh/qemu-img/kubectl/ipmitool/nvidia-smi etc — none need setuid/file-cap
# escalation (it already runs as root) — safe to block new-privilege acquisition entirely.
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=machina-agent

MemoryMax=512M
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
