# Machina platform control plane environment (installed by scripts/install-platform.sh).
# Override in /etc/default/machina-platform for production.

MACHINA_CONTROLLER_ID=ctrl-primary
DATABASE_URL=sqlite:///var/lib/machina/controller.db
MACHINA_AGENT_ADDR=127.0.0.1:50051
MACHINA_LIBVIRT_URI=qemu:///system
MACHINA_PUBLIC_URL=http://127.0.0.1:5093
MACHINA_WEB_URL=http://127.0.0.1:5092
MACHINA_SKIP_AUTH=1
# Applies to machina-controller only. Daemon auth uses MACHINA_DAEMON_SKIP_AUTH in /etc/default/machina-daemon.
RUST_LOG=info

# PacketWolf RCA bridge (auto-merged by install-platform.sh when packetwolf-api.service exists):
# PACKETWOLF_ENABLED=1
# PACKETWOLF_BASE_URL=https://127.0.0.1:9443
# PACKETWOLF_INSECURE_TLS=1
# PACKETWOLF_API_KEY=<from /etc/packetwolf/config.env>
